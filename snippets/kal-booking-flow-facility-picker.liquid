{% comment %}
  Real facility-switcher dropdown (mock data — see kal-booking-flow.js's
  FACILITY SWITCHER comment). Extracted out of kal-booking-flow-step-header.liquid
  so this same interactive picker can be reused wherever the flow shows a
  clinic name — originally just the mobile header badge (Concern Select /
  Doctor Select / Slot Picker), now also Concern Select's desktop "Selected
  Clinic" pill in its left info column, instead of that column building its
  own disconnected, non-functional copy of the same info.

  All the click/toggle/select handling in kal-booking-flow.js already
  targets these data-kal-facility-* attributes generically via
  querySelectorAll/closest() (see FACILITY SWITCHER + FACILITY SELECTION),
  so multiple instances of this snippet on screen at once "just work" with
  no JS changes — same pattern as every other data-kal-* hook in this flow.

  Accepts:
  - step_number: {Number} passed through to data-kal-facility-picker-step,
    used by the "not available here" Continue/Change Clinic warning to
    know which step triggered a switch (Concern Select never triggers that
    warning — no doctor picked yet at that point).
  - location_text: {String} facility name shown in the badge — defaults to
    "Indiranagar" (dummy value, same placeholder used everywhere else in
    this flow until it's wired to a real facility).
  - extra_class: {String} optional, appended to the outer .kal-facility-picker
    wrapper for context-specific styling (e.g. Concern Select's desktop
    pill look), without needing a copy of this markup per context.

  Usage:
  {% render 'kal-booking-flow-facility-picker', step_number: 1, location_text: 'Indiranagar' %}
{% endcomment %}

{%- liquid
  assign location_text = location_text | default: 'Indiranagar'
-%}

<div class="kal-facility-picker{% if extra_class %} {{ extra_class }}{% endif %}" data-kal-facility-picker data-kal-facility-picker-step="{{ step_number }}">
  <button
    type="button"
    class="kal-step-header__location-badge"
    data-kal-facility-toggle
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    <span class="kal-step-header__location-badge-left">
      {%- comment -%}
        Two icons, one hidden — Video Consult swaps the pin for the
        monitor glyph (setOnlineHeaderState() in kal-booking-flow.js
        toggles which is hidden) since there's no physical location
        once online. Both live in the DOM rather than swapping
        innerHTML from JS, matching this file's existing flag-swap
        convention in the phone country picker.
      {%- endcomment -%}
      <span class="kal-icon kal-icon--location">
        <span data-kal-location-icon-offline>{%- render 'kal-booking-icons', icon_name: 'location-pin' -%}</span>
        <span data-kal-location-icon-online hidden>{%- render 'kal-booking-icons', icon_name: 'mode-online' -%}</span>
      </span>
      <span class="kal-step-header__location-text">{{ location_text }}</span>
      {%- comment -%}
        Chevron now lives inside this same wrapper (was a separate
        sibling span, with the badge itself doing justify-content:
        space-between to push it to the right edge) — margin-left:auto
        on the chevron reproduces that exact same right-aligned
        position without needing a second flex child on the badge.
      {%- endcomment -%}
      <span class="kal-step-header__location-chevron" aria-hidden="true">
        {%- render 'kal-booking-icons', icon_name: 'chevron-down' -%}
      </span>
    </span>
  </button>
  <ul class="kal-country-picker__panel" data-kal-facility-panel hidden role="listbox" aria-label="Choose a clinic">
    <li role="presentation">
      <button type="button" class="kal-country-picker__option kal-facility-picker__option" data-kal-facility-option data-kal-facility-option-id="indiranagar" data-kal-facility-name="Indiranagar" role="option" aria-selected="true">
        <span class="kal-country-picker__label">Indiranagar</span>
        <span class="kal-facility-picker__check">{%- render 'kal-booking-icons', icon_name: 'check' -%}</span>
      </button>
    </li>
    <li role="presentation">
      <button type="button" class="kal-country-picker__option kal-facility-picker__option" data-kal-facility-option data-kal-facility-option-id="hsr-layout" data-kal-facility-name="HSR layout" role="option" aria-selected="false">
        <span class="kal-country-picker__label">HSR layout</span>
        <span class="kal-facility-picker__check">{%- render 'kal-booking-icons', icon_name: 'check' -%}</span>
      </button>
    </li>
    <li role="presentation">
      <button type="button" class="kal-country-picker__option kal-facility-picker__option" data-kal-facility-option data-kal-facility-option-id="jayanagar" data-kal-facility-name="Jayanagar" role="option" aria-selected="false">
        <span class="kal-country-picker__label">Jayanagar</span>
        <span class="kal-facility-picker__check">{%- render 'kal-booking-icons', icon_name: 'check' -%}</span>
      </button>
    </li>
    <li role="presentation">
      <button type="button" class="kal-country-picker__option kal-facility-picker__option" data-kal-facility-option data-kal-facility-option-id="koramangala" data-kal-facility-name="Koramangala" role="option" aria-selected="false">
        <span class="kal-country-picker__label">Koramangala</span>
        <span class="kal-facility-picker__check">{%- render 'kal-booking-icons', icon_name: 'check' -%}</span>
      </button>
    </li>
    <li role="presentation">
      <button type="button" class="kal-country-picker__option kal-facility-picker__option" data-kal-facility-option data-kal-facility-option-id="sarjapur" data-kal-facility-name="Sarjapur" role="option" aria-selected="false">
        <span class="kal-country-picker__label">Sarjapur</span>
        <span class="kal-facility-picker__check">{%- render 'kal-booking-icons', icon_name: 'check' -%}</span>
      </button>
    </li>
    <li role="presentation">
      <button type="button" class="kal-country-picker__option kal-facility-picker__option" data-kal-facility-option data-kal-facility-option-id="whitefield" data-kal-facility-name="Whitefield" role="option" aria-selected="false">
        <span class="kal-country-picker__label">Whitefield</span>
        <span class="kal-facility-picker__check">{%- render 'kal-booking-icons', icon_name: 'check' -%}</span>
      </button>
    </li>
  </ul>
</div>
