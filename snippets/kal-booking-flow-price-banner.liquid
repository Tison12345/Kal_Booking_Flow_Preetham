{% comment %}
  Price/info banner for the doctor-selection step — shows the price and note
  for whichever consultation mode is currently active (In-clinic / Video
  consult), swapped via JS (setMode() in kal-booking-flow.js) reading
  data-kal-mode-content. Shared between mobile and desktop compositions.

  Usage:
  {% render 'kal-booking-flow-price-banner' %}
{% endcomment %}

<div class="kal-step-doctor-select__price-banner">
  {%- comment -%} Video consult variant — visible by default, since that toggle starts active {%- endcomment -%}
  <div data-kal-mode-content="video">
    <div class="kal-step-doctor-select__price-row">
      <span class="kal-icon kal-icon--currency">
        {%- render 'kal-booking-icons', icon_name: 'currency-rupee' -%}
      </span>
      <span class="kal-step-doctor-select__price">300</span>
      <span class="kal-step-doctor-select__price-label">30 min video consult</span>
    </div>
    <p class="kal-step-doctor-select__price-note">
      Joining link will be sent by SMS &amp; email 15 minutes before the slot
    </p>
  </div>
  {%- comment -%} In-clinic variant — DUMMY price (₹800), hidden by default {%- endcomment -%}
  <div data-kal-mode-content="in-clinic" hidden>
    <div class="kal-step-doctor-select__price-row">
      <span class="kal-icon kal-icon--currency">
        {%- render 'kal-booking-icons', icon_name: 'currency-rupee' -%}
      </span>
      <span class="kal-step-doctor-select__price">800</span>
      <span class="kal-step-doctor-select__price-label">30 min consultation</span>
    </div>
    <p class="kal-step-doctor-select__price-note">
      No charge if rescheduled 24h ahead
    </p>
  </div>
</div>
