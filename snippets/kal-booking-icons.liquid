{% comment %}
  Centralized icon lookup for the booking flow, matching the real theme's
  kerala-ayurveda-icons.liquid pattern — one snippet, icons looked up by name,
  so a repeated icon (like the arrow) isn't pasted separately everywhere it's used.

  Accepts:
  - icon_name: {String} Icon name
  - class: {String} Optional class to add to the svg

  Usage:
  {% render 'kal-booking-icons', icon_name: 'arrow-right' %}
{% endcomment %}

{% case icon_name %}
  {% when 'calendar' %}
    {%- comment -%}
      Stethoscope glyph, used for the "Book a consultation" option card.
      Sits inside a translucent white "Overlay" (48x48, rgba(250,250,249,0.15),
      12px radius) per the Figma spec — the same treatment the old calendar
      icon used, so it reads on the dark primary card instead of the raw
      export's own solid light-grey square. Icon paths are unchanged from the
      export (still their native 36x36 coordinate space, centered already),
      just wrapped in a 48x48 frame and shifted +6/+6 to stay centered, with
      the stroke switched from grey to white so it's visible against the
      translucent overlay.
    {%- endcomment -%}
    <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="{{ class }}">
      <rect width="48" height="48" rx="12" fill="#FAFAF9" fill-opacity="0.15"/>
      <g transform="translate(6 6)">
        <path d="M14.1042 11.9795H12.6875C12.2963 11.9795 11.9792 12.2966 11.9792 12.6878V15.167C11.9792 17.3186 13.7234 19.0628 15.875 19.0628C18.0266 19.0628 19.7708 17.3186 19.7708 15.167V12.6878C19.7708 12.2966 19.4537 11.9795 19.0625 11.9795H17.6458" stroke="#FAFAF9" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M22.6042 20.4792V21.3646C22.6042 23.2228 21.0978 24.7292 19.2396 24.7292C17.3813 24.7292 15.875 23.2228 15.875 21.3646V19.0625" stroke="#FAFAF9" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M17.6458 11.2705V12.6872" stroke="#FAFAF9" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M14.1042 11.2705V12.6872" stroke="#FAFAF9" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M24.0208 19.0622C24.0208 19.8446 23.3866 20.4788 22.6042 20.4788C21.8217 20.4788 21.1875 19.8446 21.1875 19.0622C21.1875 18.2797 21.8217 17.6455 22.6042 17.6455C23.3866 17.6455 24.0208 18.2797 24.0208 19.0622Z" stroke="#FAFAF9" stroke-width="1.25"/>
      </g>
    </svg>

  {% when 'monitor' %}
    {%- comment -%}
      Leaf/plant glyph, used for the "Request a therapy session" option card.
      Sits inside a translucent mint "Background" (48x48, rgba(228,242,235,0.5),
      12px radius) per the Figma spec — same treatment style as the stethoscope
      icon's overlay, just mint instead of white since this card is white/light
      rather than dark. Icon fill switched from white to dark green (#00503A,
      matching the original monitor icon's stroke color) so it reads against
      the light background. Path unchanged from the export, shifted +6/+6 to
      stay centered in the larger 48x48 frame. Original Figma export used an
      alpha mask to bound the path to its 24x24 icon area; dropped here since
      the path already sits fully inside that area on its own — a plain filled
      path avoids introducing a mask id that would be duplicated in the DOM
      (this icon renders twice: mobile + desktop).
    {%- endcomment -%}
    <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="{{ class }}">
      <rect width="48" height="48" rx="12" fill="#E4F2EB" fill-opacity="0.5"/>
      <g transform="translate(6 6)">
        <path d="M17.373 27.3554C16.3025 27.1516 15.2493 26.8039 14.2135 26.3122C13.1777 25.8205 12.253 25.1365 11.4395 24.2602C10.626 23.384 9.96799 22.302 9.46549 21.0142C8.96282 19.7264 8.71149 18.1895 8.71149 16.4037V16.2227C8.71149 16.015 8.7769 15.8459 8.90774 15.7152C9.03857 15.5844 9.20782 15.5189 9.41549 15.5189H9.57699C10.35 15.5189 11.2009 15.6561 12.1297 15.9304C13.0586 16.2048 13.8858 16.5714 14.6115 17.0304C14.7437 15.8548 15.0527 14.6378 15.5385 13.3794C16.0243 12.1213 16.625 10.9896 17.3405 9.98444C17.5148 9.7396 17.7347 9.61719 18 9.61719C18.2653 9.61719 18.4852 9.7396 18.6595 9.98444C19.375 10.9896 19.9757 12.1245 20.4615 13.3892C20.9473 14.6539 21.2563 15.874 21.3885 17.0497C22.0948 16.61 22.906 16.2498 23.822 15.9689C24.738 15.6881 25.5986 15.5381 26.4037 15.5189L26.5422 15.5094C26.7537 15.5029 26.9342 15.5744 27.0835 15.7237C27.233 15.873 27.3045 16.0535 27.298 16.2652L27.2885 16.4227C27.2435 18.042 27.0034 19.4651 26.5682 20.6919C26.1329 21.9189 25.547 22.9738 24.8105 23.8564C24.074 24.7391 23.207 25.4599 22.2095 26.0189C21.2122 26.5779 20.1269 27.0074 18.9537 27.3074C18.7371 27.3599 18.4737 27.3894 18.1635 27.3957C17.8532 27.4022 17.5897 27.3888 17.373 27.3554ZM18.1422 25.9497C17.9589 23.1997 17.1297 21.1122 15.6547 19.6872C14.1797 18.2622 12.3756 17.383 10.2422 17.0497C10.2089 17.0497 10.2089 17.0497 10.2422 17.0497C10.4256 19.8664 11.2797 21.983 12.8047 23.3997C14.3297 24.8164 16.1089 25.6664 18.1422 25.9497C18.1756 25.9664 18.1756 25.9705 18.1422 25.9622C18.1089 25.9539 18.1089 25.9497 18.1422 25.9497ZM16.05 17.9497C16.4025 18.2459 16.7573 18.6058 17.1145 19.0294C17.4715 19.4533 17.7667 19.8614 18 20.2537C18.2372 19.8614 18.5333 19.4533 18.8885 19.0294C19.2437 18.6058 19.5975 18.2459 19.95 17.9497C19.9295 16.9677 19.7484 15.9376 19.4067 14.8594C19.0651 13.7811 18.5962 12.7407 18 11.7382C17.4038 12.7407 16.9349 13.7794 16.5932 14.8544C16.2516 15.9294 16.0705 16.9612 16.05 17.9497ZM18.8115 21.8919C19.0115 22.4253 19.1792 22.9862 19.3145 23.5747C19.4497 24.1632 19.5589 24.8241 19.6422 25.5574C20.3256 25.3253 21.0134 24.998 21.7057 24.5757C22.3981 24.1532 23.026 23.6039 23.5895 22.9277C24.1528 22.2514 24.6332 21.4321 25.0307 20.4699C25.4282 19.5078 25.6706 18.3677 25.7577 17.0497C25.7577 17.0164 25.7577 17.0164 25.7577 17.0497C24.1654 17.283 22.7583 17.8279 21.5365 18.6842C20.3147 19.5407 19.4063 20.6099 18.8115 21.8919Z" fill="#00503A"/>
      </g>
    </svg>

  {% when 'arrow-right' %}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}">
      <path d="M5 12h14"/>
      <path d="m12 5 7 7-7 7"/>
    </svg>

  {% when 'chevron-left' %}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}">
      <path d="m15 18-6-6 6-6"/>
    </svg>

  {% when 'location-pin' %}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}">
      <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
      <circle cx="12" cy="10" r="3"/>
    </svg>

  {% when 'video-camera' %}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}">
      <path d="m16 8 3.5-2.5A1 1 0 0 1 21 6.3v11.4a1 1 0 0 1-1.5.8L16 16"/>
      <rect x="2" y="6" width="14" height="12" rx="2"/>
    </svg>

  {% when 'clock' %}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}">
      <circle cx="12" cy="12" r="10"/>
      <path d="M12 6v6l4 2"/>
    </svg>

  {% when 'check' %}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}">
      <path d="M20 6 9 17l-5-5"/>
    </svg>

  {% when 'currency-rupee' %}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}">
      <path d="M6 3h12"/>
      <path d="M6 8h12"/>
      <path d="M6 13h3a4.5 4.5 0 0 0 0-9"/>
      <path d="M9 13c6 0 8 4 8 8"/>
      <path d="M6 13h1"/>
    </svg>

  {% when 'calendar-days' %}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}">
      <path d="M8 2v4"/>
      <path d="M16 2v4"/>
      <rect x="3" y="4" width="18" height="18" rx="2"/>
      <path d="M3 10h18"/>
    </svg>

  {% when 'chevron-right' %}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}">
      <path d="m9 18 6-6-6-6"/>
    </svg>

  {% when 'credit-card' %}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}">
      <rect x="2" y="5" width="20" height="14" rx="2"/>
      <path d="M2 10h20"/>
      <path d="M6 15h4"/>
    </svg>

  {% when 'globe' %}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}">
      <circle cx="12" cy="12" r="10"/>
      <path d="M2 12h20"/>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    </svg>

  {% when 'briefcase' %}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}">
      <rect x="2" y="7" width="20" height="14" rx="2"/>
      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
    </svg>

{% endcase %}
