{% comment %}
  Centralized icon lookup for the booking flow, matching the real theme's
  kerala-ayurveda-icons.liquid pattern — one snippet, icons looked up by name,
  so a repeated icon (like the arrow) isn't pasted separately everywhere it's used.

  Accepts:
  - icon_name: {String} Icon name
  - class: {String} Optional class to add to the svg

  Usage:
  {% render 'kal-booking-icons', icon_name: 'arrow-right' %}
{% endcomment %}

{% case icon_name %}
  {% when 'calendar' %}
    <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="{{ class }}">
      <path d="M0 12C0 5.37258 5.37258 0 12 0H36C42.6274 0 48 5.37258 48 12V36C48 42.6274 42.6274 48 36 48H12C5.37258 48 0 42.6274 0 36V12Z" fill="#FAFAF9" fill-opacity="0.15"/>
      <path d="M20 14V18" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M28 14V18" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M31 16H17C15.8954 16 15 16.8954 15 18V32C15 33.1046 15.8954 34 17 34H31C32.1046 34 33 33.1046 33 32V18C33 16.8954 32.1046 16 31 16Z" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M15 22H33" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M20 26H20.01" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M24 26H24.01" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M28 26H28.01" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M20 30H20.01" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M24 30H24.01" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M28 30H28.01" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {% when 'monitor' %}
    <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="{{ class }}">
      <path d="M0 12C0 5.37258 5.37258 0 12 0H36C42.6274 0 48 5.37258 48 12V36C48 42.6274 42.6274 48 36 48H12C5.37258 48 0 42.6274 0 36V12Z" fill="#E4F2EB"/>
      <path d="M32 15H16C14.8954 15 14 15.8954 14 17V27C14 28.1046 14.8954 29 16 29H32C33.1046 29 34 28.1046 34 27V17C34 15.8954 33.1046 15 32 15Z" stroke="#00503A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M20 33H28" stroke="#00503A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M24 29V33" stroke="#00503A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {% when 'arrow-right' %}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ class }}">
      <path d="M5 12h14"/>
      <path d="m12 5 7 7-7 7"/>
    </svg>

{% endcase %}
