{% comment %}
  Global booking flow, triggered from any CTA with class "kal-request-appointment-cta"
  anywhere in the theme. Rendered once in layout/theme.liquid.
  Uses the native <dialog> element so it always renders above all other page
  content, regardless of any CSS transform/stacking-context elsewhere in the theme.
{% endcomment %}

{{ 'kal-booking-flow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kal-booking-flow.js' | asset_url }}" defer></script>

<dialog
  id="kal-booking-flow"
  class="kal-booking-flow"
  data-api-base-url="{{ settings.kal_booking_api_base_url }}"
  data-whatsapp-number="{{ settings.kal_booking_whatsapp_number }}"
>
  <button class="kal-booking-flow__close" data-kal-close aria-label="Close">×</button>
  <div class="kal-booking-flow__content" id="kal-booking-flow-content">
    <div data-kal-step="entry">
      {% render 'kal-booking-flow-step-entry' %}
    </div>
    <div data-kal-step="doctor-select" hidden>
      {% render 'kal-booking-flow-step-doctor-select' %}
    </div>
    <div data-kal-step="slot-picker" hidden>
      {% render 'kal-booking-flow-step-slot-picker' %}
    </div>
    <div data-kal-step="patient-details" hidden>
      {% render 'kal-booking-flow-step-patient-details' %}
    </div>
  </div>

  {%- comment -%}
    Calendar modal for the Slot Picker step — deliberately a direct child of
    <dialog>, NOT nested inside #kal-booking-flow-content. That div has
    overflow-y:auto, and on desktop the dialog itself has a transform (for
    centering), which makes the dialog the containing block for any
    position:fixed descendant. Once that happens, any overflow:auto ancestor
    sitting between the fixed element and its containing block clips it — so
    nesting the modal inside the scrolling content area was silently clipping
    it on desktop. Living here, one level below the transformed <dialog>
    with nothing scrollable in between, avoids that entirely.
  {%- endcomment -%}
  <div class="kal-calendar-modal" data-kal-calendar-modal hidden>
    <div class="kal-calendar-modal__backdrop" data-kal-close-calendar></div>
    <div class="kal-calendar-modal__panel">
      <div class="kal-calendar-modal__header">
        <button type="button" class="kal-icon-button" data-kal-calendar-prev aria-label="Previous month">
          {%- render 'kal-booking-icons', icon_name: 'chevron-left' -%}
        </button>
        <span class="kal-calendar-modal__month" data-kal-calendar-month>Month Year</span>
        <button type="button" class="kal-icon-button" data-kal-calendar-next aria-label="Next month">
          {%- render 'kal-booking-icons', icon_name: 'chevron-right' -%}
        </button>
      </div>
      <div class="kal-calendar-modal__weekdays">
        <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>
      </div>
      <div class="kal-calendar-modal__grid" data-kal-calendar-grid></div>
      <button type="button" class="kal-calendar-modal__close" data-kal-close-calendar>Done</button>
    </div>
  </div>
</dialog>
