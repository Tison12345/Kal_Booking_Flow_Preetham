{% comment %}
  Global booking flow, triggered from any CTA with class "kal-request-appointment-cta"
  anywhere in the theme. Rendered once in layout/theme.liquid.
  Uses the native <dialog> element so it always renders above all other page
  content, regardless of any CSS transform/stacking-context elsewhere in the theme.
{% endcomment %}

{{ 'kal-booking-flow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kal-booking-flow.js' | asset_url }}" defer></script>

<dialog
  id="kal-booking-flow"
  class="kal-booking-flow"
  data-api-base-url="{{ settings.kal_booking_api_base_url }}"
  data-whatsapp-number="{{ settings.kal_booking_whatsapp_number }}"
  data-doctor-photo-placeholder="{{ 'kal-doctor-photo-placeholder.jpg' | asset_url }}"
>
  {%- comment -%}
    Only visible on Entry (see goToStep() in kal-booking-flow.js — hidden
    on every other step, which render their own close button as part of
    kal-booking-flow-step-header.liquid instead). Reuses that same
    .kal-step-doctor-select__back circular/bordered treatment + 'close'
    icon here too, instead of a plain "×" character, so Entry's close
    button looks the same as every other step's.
  {%- endcomment -%}
  <button class="kal-booking-flow__close kal-step-doctor-select__back" data-kal-close aria-label="Close">
    {%- render 'kal-booking-icons', icon_name: 'close' -%}
  </button>
  <div class="kal-booking-flow__content" id="kal-booking-flow-content">
    <div data-kal-step="entry">
      {% render 'kal-booking-flow-step-entry' %}
    </div>
    <div data-kal-step="concern-select" hidden>
      {% render 'kal-booking-flow-step-concern-select' %}
    </div>
    <div data-kal-step="doctor-select" hidden>
      {% render 'kal-booking-flow-step-doctor-select' %}
    </div>
    <div data-kal-step="slot-picker" hidden>
      {% render 'kal-booking-flow-step-slot-picker' %}
    </div>
    <div data-kal-step="patient-details" hidden>
      {% render 'kal-booking-flow-step-patient-details' %}
    </div>
    <div data-kal-step="confirmation" hidden>
      {% render 'kal-booking-flow-step-confirmation' %}
    </div>
    <div data-kal-step="booking-confirmed" hidden>
      {% render 'kal-booking-flow-step-booking-confirmed' %}
    </div>
    <div data-kal-step="therapy-slot" hidden>
      {% render 'kal-booking-flow-step-therapy-slot' %}
    </div>
    <div data-kal-step="therapy-details" hidden>
      {% render 'kal-booking-flow-step-therapy-details' %}
    </div>
    <div data-kal-step="therapy-confirmed" hidden>
      {% render 'kal-booking-flow-step-therapy-confirmed' %}
    </div>
  </div>

  {%- comment -%}
    Facility-switch confirmation — one shared instance for the whole flow,
    not one per header render (kal-booking-flow-step-header.liquid's
    facility dropdown renders 3x, once per switchable step, all
    simultaneously in the DOM). Shown by kal-booking-flow.js's
    openFacilitySwitchModal() when switching clinics on Doctor Select/Slot
    Picker would move away from the currently-selected mock doctor's home
    clinic — doctor/facility name text is filled in by JS right before
    this becomes visible. MOCK data only (see kal-booking-flow.js's
    FACILITY SWITCHER comment) until real per-clinic doctor data replaces
    Doctor Select's 3 static mock doctor cards.

    Both real actions (Change Clinic / Book an online slot) apply the
    facility switch and send the visitor back to Doctor Select (step 2)
    to pick a doctor again — the doctor they had selected was only valid
    for their old clinic/mode combination, not the new one. The only
    difference between the two is which consultation mode Doctor Select
    lands on (in-clinic vs video), via the same setMode() the mode toggle
    buttons there already use. The corner X is the sole "never mind, stay
    on my current clinic" cancel action — no facility switch, no
    navigation.
  {%- endcomment -%}
  <div class="kal-facility-switch-modal" data-kal-facility-switch-modal hidden>
    <div class="kal-facility-switch-modal__card">
      <button type="button" class="kal-facility-switch-modal__close" data-kal-facility-switch-cancel aria-label="Close">
        {%- render 'kal-booking-icons', icon_name: 'close' -%}
      </button>
      <span class="kal-facility-switch-modal__photo">
        <img src="{{ 'kal-doctor-photo-placeholder.jpg' | asset_url }}" alt="" width="56" height="56">
      </span>
      <p class="kal-facility-switch-modal__text">
        <strong data-kal-facility-switch-doctor>Dr. Neethu Jayachandran</strong> is available in person only at the
        <strong data-kal-facility-switch-facility>Koramangala</strong> Clinic.
        Are you sure you want to switch clinics?
      </p>
      <button type="button" class="kal-step-doctor-select__continue" data-kal-facility-switch-clinic>Change Clinic</button>
      <button type="button" class="kal-facility-switch-modal__secondary" data-kal-facility-switch-online>Book an online slot</button>
    </div>
  </div>

</dialog>
