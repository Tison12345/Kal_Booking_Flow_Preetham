{% comment %}
  Entry step — the first screen shown when the booking flow opens.
  Lets the visitor choose between "Book a consultation" and "Request a therapy session".

  Location line is a DUMMY placeholder for now (we're building in the demo store,
  not on a real clinic page). Once this is ported to the real theme, this should
  read from that page's clinic settings instead — see custom-clinic-consultation-form.liquid
  in the real theme export for the pattern (clinic_name / clinic_area settings).
{% endcomment %}

<div class="kal-step kal-step--entry">
  <div class="kal-step-entry__info">
    <p class="kal-eyebrow">No sign-in needed</p>
    <h2 class="kal-heading">Calm care,<br>closer than you think.</h2>
    <p class="kal-body-text">
      Book a consultation in under a minute — in-clinic or video. Confirmation
      arrives instantly, no account required.
    </p>
    <div class="kal-step-entry__location">
      <span class="kal-icon kal-icon--location">
        <!-- ICON: location-pin -->
      </span>
      <span>
        <!-- DUMMY VALUE — replace with real clinic name/area once on a real clinic page -->
        Kerala Ayurveda Wellness Center, Koramangala &middot; Opens 8 AM
      </span>
    </div>
  </div>

  <div class="kal-step-entry__action-panel">
    <div class="kal-step-entry__banner" aria-hidden="true"></div>
    <p class="kal-label">What would you like to do?</p>

    <button type="button" class="kal-option-card kal-option-card--primary" data-kal-goto="consultation">
      <span class="kal-icon kal-icon--calendar">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 12C0 5.37258 5.37258 0 12 0H36C42.6274 0 48 5.37258 48 12V36C48 42.6274 42.6274 48 36 48H12C5.37258 48 0 42.6274 0 36V12Z" fill="#FAFAF9" fill-opacity="0.15"/>
          <path d="M20 14V18" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M28 14V18" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M31 16H17C15.8954 16 15 16.8954 15 18V32C15 33.1046 15.8954 34 17 34H31C32.1046 34 33 33.1046 33 32V18C33 16.8954 32.1046 16 31 16Z" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M15 22H33" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20 26H20.01" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M24 26H24.01" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M28 26H28.01" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20 30H20.01" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M24 30H24.01" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M28 30H28.01" stroke="#FAFAF9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="kal-option-card__text">
        <span class="kal-option-card__title">Book a consultation</span>
        <span class="kal-option-card__subtitle">In-clinic or video &mdash; under a minute</span>
      </span>
      <span class="kal-icon kal-icon--arrow">
        <!-- ICON: arrow-right -->
      </span>
    </button>

    <button type="button" class="kal-option-card kal-option-card--secondary" data-kal-goto="therapy">
      <span class="kal-icon kal-icon--monitor">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 12C0 5.37258 5.37258 0 12 0H36C42.6274 0 48 5.37258 48 12V36C48 42.6274 42.6274 48 36 48H12C5.37258 48 0 42.6274 0 36V12Z" fill="#E4F2EB"/>
          <path d="M32 15H16C14.8954 15 14 15.8954 14 17V27C14 28.1046 14.8954 29 16 29H32C33.1046 29 34 28.1046 34 27V17C34 15.8954 33.1046 15 32 15Z" stroke="#00503A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20 33H28" stroke="#00503A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M24 29V33" stroke="#00503A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="kal-option-card__text">
        <span class="kal-option-card__title">Request a therapy session</span>
        <span class="kal-option-card__subtitle">Talk to our care coordinator</span>
      </span>
      <span class="kal-icon kal-icon--arrow">
        <!-- ICON: arrow-right -->
      </span>
    </button>
  </div>
</div>
