{% comment %}
  The empty doctor card the booking flow clones for every doctor.

  Doctor details (name, qualification, experience, languages, photo, concerns)
  and the clinics a doctor is offered at come from the Shopify Doctor entries,
  rendered into the page by snippets/kal-shopify-catalog.liquid; prices come
  from the server. Nothing about a doctor is typed in this section any more,
  which is why it no longer has any doctor blocks to fill in.
{% endcomment %}

{%- comment -%}
  An empty card the script clones for every doctor whose details come from
  Shopify (the Doctor entry linked to their consultation product). It carries
  the same markup and icons as the Doctor Select cards; the script fills in name,
  degree, experience, languages, photo and tags. The one placeholder tag only
  makes the tags container render so the script has somewhere to put the real ones.
{%- endcomment -%}
<div class="kal-doctor-card-template" hidden>
  {%- render 'kal-booking-flow-doctor-card',
    name: '',
    degree: '',
    languages: '',
    experience: '',
    tags: 'x',
    next_slot: '',
    price: '',
    photo_url: ''
  -%}
</div>

{% schema %}
{
  "name": "Doctor cards (Kal)",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [
    {
      "type": "doctor_profile",
      "name": "Doctor",
      "settings": [
        {
          "type": "text",
          "id": "doctor_id",
          "label": "Doctor ID (from the CMS staff table)",
          "info": "Real UUID from Supabase. This doctor's card only shows in the booking flow if this ID also comes back from GET /api/public/doctors for the selected facility."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Dr. Neethu Jayachandran"
        },
        {
          "type": "text",
          "id": "degree",
          "label": "Degree",
          "default": "BAMS"
        },
        {
          "type": "text",
          "id": "languages",
          "label": "Languages (pre-joined, e.g. \"English · Hindi\")",
          "default": "English &middot; Hindi &middot; Malayalam"
        },
        {
          "type": "text",
          "id": "experience",
          "label": "Experience",
          "default": "12 yrs experience"
        },
        {
          "type": "text",
          "id": "tags",
          "label": "Specialty tags (comma-separated)",
          "info": "Enter at least 4. If a visitor picked a concern on Concern Select (e.g. \"Gut Health\") and one of these tags matches it exactly, that tag is highlighted on the card and the tags are shown in random order — fewer than 4 makes that look sparse/obviously templated.",
          "default": "Anxiety,Stress Management,Diabetes Care,Preventive Health"
        },
        {
          "type": "text",
          "id": "next_slot",
          "label": "Next slot text (cosmetic — real slot data isn't wired to this yet)",
          "default": "Today, 10:30 AM"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price (pre-formatted, e.g. \"₹500\")",
          "default": "&#8377;500"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Doctor cards (Kal)",
      "blocks": [
        { "type": "doctor_profile" }
      ]
    }
  ]
}
{% endschema %}
