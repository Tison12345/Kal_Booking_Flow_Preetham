{% comment %}
  "Find a Clinic" list section — feeds the booking flow's facility selection.

  Renders an empty container only. kal-booking-flow.js's renderClinicList()
  builds one card per Clinic entry in Shopify (shop.metaobjects.clinic, read
  from the catalog rendered into the page by snippets/kal-shopify-catalog.liquid),
  each carrying that entry's own facility_id. Clicking a card reads
  data-facility-id directly off itself — there is no name-matching step and no
  theme-editor-typed ID — so a clinic's display name can change in Shopify at
  any time without ever risking the wrong clinic getting booked.
{% endcomment %}

{{ 'kal-clinic-list.css' | asset_url | stylesheet_tag }}

<div class="kal-clinic-list-page">
  {%- if section.settings.section_heading != blank -%}
    <h2 class="kal-clinic-list__heading">{{ section.settings.section_heading }}</h2>
  {%- endif -%}

  <ul class="kal-clinic-list" data-kal-clinic-list>
    <li class="kal-clinic-list__empty">Loading clinics…</li>
  </ul>
</div>

{% schema %}
{
  "name": "Clinic list (Kal booking)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section heading",
      "default": "Our Clinics"
    }
  ],
  "presets": [
    { "name": "Clinic list (Kal booking)" }
  ]
}
{% endschema %}
