{% comment %}
  "Find a Clinic" list section — feeds the booking flow's facility selection.

  Fully backend-driven, per explicit instruction: this section renders an
  empty container only. kal-booking-flow.js's renderClinicList() fetches
  GET facilities (via the storefront proxy, same endpoint/cache
  getCurrentFacility() uses) and builds one card per real facility,
  carrying that facility's own id and name straight off the response.
  Clicking a card reads data-facility-id directly off itself — there is no
  name-matching step and no theme-editor-typed ID — so a clinic's display
  name can change in the CMS at any time without ever risking the wrong
  facility getting booked.
{% endcomment %}

{{ 'kal-clinic-list.css' | asset_url | stylesheet_tag }}

<div class="kal-clinic-list-page">
  {%- if section.settings.section_heading != blank -%}
    <h2 class="kal-clinic-list__heading">{{ section.settings.section_heading }}</h2>
  {%- endif -%}

  <ul class="kal-clinic-list" data-kal-clinic-list>
    <li class="kal-clinic-list__empty">Loading clinics…</li>
  </ul>
</div>

{% schema %}
{
  "name": "Clinic list (Kal booking)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section heading",
      "default": "Our Clinics"
    }
  ],
  "presets": [
    { "name": "Clinic list (Kal booking)" }
  ]
}
{% endschema %}
